import Foundation

/// Data model for parsing sample_List.json
struct SampleListData: Codable {
    let genres: [GenreData]
}

struct GenreData: Codable, Equatable {
    let primary: String
    let secondaries: [SecondaryGenreData]
}

struct SecondaryGenreData: Codable, Equatable {
    let secondary: String
    let samples: [SampleMovieEntry]  // Sample movie entries with optional logline
}

/// Represents a sample movie entry that can be parsed from JSON
/// Supports both simple string format "Movie Title (Year)" and object format with logline
struct SampleMovieEntry: Codable, Equatable, Hashable {
    let title: String
    let year: Int
    let logline: String?
    
    enum CodingKeys: String, CodingKey {
        case title, year, logline
    }
    
    /// Initialize from JSON that might be a string or object
    init(from decoder: Decoder) throws {
        // Try to decode as a keyed container first (object format)
        do {
            let container = try decoder.container(keyedBy: CodingKeys.self)
            self.title = try container.decode(String.self, forKey: .title)
            self.year = try container.decode(Int.self, forKey: .year)
            self.logline = try? container.decode(String?.self, forKey: .logline)
        } catch {
            // If that fails, try to decode as a string
            let container = try decoder.singleValueContainer()
            if let jsonString = try? container.decode(String.self) {
                // Parse "Movie Title (Year)" format
                let parsed = SampleListLoader.parseMovieString(jsonString)
                self.title = parsed?.title ?? jsonString
                self.year = parsed?.year ?? 2000
                self.logline = nil
            } else {
                throw error
            }
        }
    }
}
